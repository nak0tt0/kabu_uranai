<div style="max-width: 400px; margin: 40px auto; padding: 20px; border: 1px solid #ccc; border-radius: 8px;">
  <h2>ログイン</h2>

  <%= form_with(url: login_path, scope: :session, local: true) do |f| %>
    <div style="margin-bottom: 15px;">
      <%= f.label :email, "メールアドレス" %><br>
      <%= f.email_field :email, required: true, style: "width: 100%; padding: 8px;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :password, "パスワード" %><br>
      <%= f.password_field :password, required: true, style: "width: 100%; padding: 8px;" %>
    </div>

    <div>
      <%= f.submit "ログイン", style: "width: 100%; padding: 10px; background-color: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer;" %>
    </div>
  <% end %>

  <hr style="margin: 20px 0;">

  <!-- ゲストログインボタン -->
  <%= button_to "ポートフォリオを試す（ゲストログイン）", guest_login_path, method: :post, style: "width: 100%; padding: 10px; background-color: #6c757d; color: white; border: none; border-radius: 4px; cursor: pointer;" %>
</div>
