<div style="padding: 20px; max-width: 800px; margin: 0 auto;">
  <h2>ユーザー詳細情報</h2>

  <div style="background-color: #f8f9fa; padding: 20px; border-radius: 8px; margin-bottom: 20px;">
    <p><strong>ユーザーID:</strong> <%= @user.id %></p>
    <p><strong>名前:</strong> <%= @user.name.presence || "未設定" %></p>
    <p><strong>メールアドレス:</strong> <%= @user.email %></p>
    <p><strong>登録日時:</strong> <%= @user.created_at.strftime("%Y/%m/%d %H:%M:%S") %></p>
  </div>

  <div style="display: flex; gap: 10px;">
    <%= link_to "一覧に戻る", admin_users_path, style: "padding: 8px 16px; background-color: #6c757d; color: white; text-decoration: none; border-radius: 4px;" %>
    <%= button_to "このユーザーを強制退会", admin_user_path(@user), method: :delete, data: { turbo_confirm: "本当にこのユーザーを削除（強制退会）しますか？" }, style: "padding: 8px 16px; background-color: #dc3545; color: white; border: none; border-radius: 4px; cursor: pointer;" %>
  </div>
</div>
