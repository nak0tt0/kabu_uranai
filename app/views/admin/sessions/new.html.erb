<div style="max-width: 400px; margin: 40px auto; padding: 20px; border: 2px solid #dc3545; border-radius: 8px;">
  <h2 style="color: #dc3545;">管理者ログイン</h2>

  <%= form_with(url: admin_login_path, scope: :session, local: true) do |f| %>
    <div style="margin-bottom: 15px;">
      <%= f.label :email, "管理者メールアドレス" %><br>
      <%= f.email_field :email, required: true, style: "width: 100%; padding: 8px;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :password, "パスワード" %><br>
      <%= f.password_field :password, required: true, style: "width: 100%; padding: 8px;" %>
    </div>

    <div>
      <%= f.submit "管理者ログイン", style: "width: 100%; padding: 10px; background-color: #dc3545; color: white; border: none; border-radius: 4px; cursor: pointer;" %>
    </div>
  <% end %>
</div>
