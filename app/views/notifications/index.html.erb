<div style="padding: 20px; max-width: 800px; margin: 0 auto;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h2>お知らせ・通知一覧</h2>
    <div>
      <% if current_user.notifications.unread.any? %>
        <%= button_to "すべて既読にする", read_all_notifications_path, method: :patch, style: "padding: 6px 12px; background-color: #6c757d; color: white; border: none; border-radius: 4px; cursor: pointer; margin-right: 10px; display: inline-block;" %>
      <% end %>
      <%= link_to "マイページに戻る", mypage_path, style: "color: #007bff; text-decoration: none;" %>
    </div>
  </div>

  <% if flash[:notice].present? %>
    <p style="color: green;"><%= flash[:notice] %></p>
  <% end %>

  <% if @notifications.any? %>
    <ul style="list-style: none; padding: 0;">
      <% @notifications.each do |notification| %>
        <li style="border: 1px solid #ddd; border-radius: 6px; padding: 15px; margin-bottom: 10px; background-color: <%= notification.read? ? '#ffffff' : '#eaf4ff' %>;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
              <span style="font-size: 12px; color: #6c757d; margin-right: 8px;"><%= notification.created_at.strftime("%Y/%m/%d %H:%M") %></span>
              <% unless notification.read? %>
                <span style="background-color: #007bff; color: white; font-size: 10px; padding: 2px 6px; border-radius: 4px; font-weight: bold;">未読</span>
              <% end %>
              <p style="margin: 8px 0 0 0; font-size: 15px; line-height: 1.5;"><%= notification.message %></p>
            </div>
            <% unless notification.read? %>
              <div>
                <%= button_to "既読にする", read_notification_path(notification), method: :patch, style: "padding: 4px 8px; background-color: #28a745; color: white; border: none; border-radius: 4px; font-size: 12px; cursor: pointer;" %>
              </div>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div style="background-color: #f8f9fa; padding: 20px; text-align: center; border-radius: 6px; color: #6c757d;">
      <p style="margin: 0;">現在届いている通知はありません。</p>
    </div>
  <% end %>
</div>
