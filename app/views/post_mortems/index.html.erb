<div style="padding: 20px; max-width: 900px; margin: 0 auto;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h2>振り返りノート（事後検証）一覧</h2>
    <%= link_to "マイページに戻る", mypage_path, style: "color: #007bff; text-decoration: none;" %>
  </div>

  <% if flash[:notice].present? %>
    <p style="color: green;"><%= flash[:notice] %></p>
  <% end %>

  <% if @post_mortems.any? %>
    <table border="1" cellpadding="10" cellspacing="0" style="width: 100%; border-collapse: collapse; text-align: left;">
      <thead>
        <tr style="background-color: #f8f9fa;">
          <th>対象銘柄</th>
          <th>売却理由</th>
          <th>実績リターン(%)</th>
          <th>記録日</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% @post_mortems.each do |pm| %>
          <tr>
            <td>
              <strong><%= pm.stock.name %></strong><br>
              <small style="color: #6c757d;"><%= pm.stock.ticker_symbol %></small>
            </td>
            <td><%= truncate(pm.reason_for_sale, length: 30) %></td>
            <td>
              <% if pm.actual_return_percentage.present? %>
                <span style="color: <%= pm.actual_return_percentage >= 0 ? 'green' : 'red' %>; font-weight: bold;">
                  <%= pm.actual_return_percentage %>%
                </span>
              <% else %>
                <span style="color: #888;">未入力</span>
              <% end %>
            </td>
            <td><%= pm.created_at.strftime("%Y/%m/%d") %></td>
            <td>
              <%= link_to "詳細", post_mortem_path(pm), style: "color: #17a2b8; margin-right: 8px;" %>
              <%= link_to "編集", edit_post_mortem_path(pm), style: "color: #ffc107;" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div style="background-color: #f8f9fa; padding: 20px; text-align: center; border-radius: 6px; color: #6c757d;">
      <p style="margin: 0;">まだ記録された振り返りノートはありません。</p>
      <small>銘柄詳細ページから「売却・振り返りを記録」を行うことでここに追加されます。</small>
    </div>
  <% end %>
</div>
