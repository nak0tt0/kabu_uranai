<div style="padding: 20px; max-width: 500px; margin: 0 auto;">
  <h2>タグ名の編集</h2>

  <%= form_with model: @tag, local: true do |f| %>
    <div style="margin-bottom: 15px;">
      <%= f.label :name, "タグ名", style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
      <%= f.text_field :name, required: true, style: "width: 100%; padding: 8px; box-sizing: border-box;" %>
    </div>

    <div>
      <%= f.submit "更新する", style: "padding: 8px 16px; background-color: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer;" %>
      <%= link_to "キャンセル", tags_path, style: "margin-left: 10px; color: #6c757d;" %>
    </div>
  <% end %>
</div>
