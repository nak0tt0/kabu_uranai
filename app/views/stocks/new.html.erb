<div style="max-width: 600px; margin: 30px auto; padding: 20px;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h2>新規銘柄登録</h2>
    <%= link_to "一覧へ戻る", stocks_path, style: "color: #6c757d; text-decoration: none;" %>
  </div>

  <% if flash[:alert].present? %>
    <p style="color: red; background-color: #ffe6e6; padding: 10px; border-radius: 4px; margin-bottom: 20px;"><%= flash[:alert] %></p>
  <% end %>

  <!-- CSV取り込みセクション -->
  <div style="background-color: #f0f7ff; border: 2px dashed #007bff; border-radius: 8px; padding: 20px; margin-bottom: 30px; text-align: center;">
    <h3 style="margin-top: 0; color: #007bff;">📥 証券会社CSVから一括インポート</h3>
    <p style="font-size: 13px; color: #6c757d; margin-bottom: 15px;">楽天証券等の「保有商品一覧.csv」を選択して取り込むことができます。</p>
    
    <%= form_with url: import_stocks_path, multipart: true, local: true do |f| %>
      <div style="margin-bottom: 15px;">
        <%= f.file_field :file, accept: ".csv", style: "font-size: 14px;" %>
      </div>
      <%= f.submit "CSVを取り込んで登録", style: "padding: 8px 20px; background-color: #007bff; color: white; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;" %>
    <% end %>
  </div>

  <hr style="border: none; border-top: 1px solid #ccc; margin: 30px 0;">

  <!-- 通常の手入力フォーム -->
  <h3>手動で登録する</h3>
  <%= form_with model: @stock, local: true do |f| %>
    <div style="margin-bottom: 15px;">
      <%= f.label :ticker_symbol, "銘柄コード（例: 7203, AAPL）" %><br>
      <%= f.text_field :ticker_symbol, style: "width: 100%; padding: 8px;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :name, "銘柄名" %><br>
      <%= f.text_field :name, required: true, style: "width: 100%; padding: 8px;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :shares, "保有株数" %><br>
      <%= f.number_field :shares, step: "any", style: "width: 100%; padding: 8px;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :acquisition_price, "取得単価" %><br>
      <%= f.number_field :acquisition_price, step: "any", style: "width: 100%; padding: 8px;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :purchase_motivation, "購入動機（なぜ買ったか）" %><br>
      <%= f.text_area :purchase_motivation, required: true, rows: 3, style: "width: 100%; padding: 8px;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :exit_scenario, "売却基準・シナリオ（どうなったら売るか）" %><br>
      <%= f.text_area :exit_scenario, rows: 3, style: "width: 100%; padding: 8px;" %>
    </div>

    <div>
      <%= f.submit "手動で保存する", style: "padding: 10px 20px; background-color: #28a745; color: white; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;" %>
    </div>
  <% end %>
</div>
