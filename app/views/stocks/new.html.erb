<div style="max-width: 600px; margin: 30px auto; padding: 20px; border: 1px solid #ccc; border-radius: 8px;">
  <h2>保有銘柄_新規登録</h2>

  <% if @stock.errors.any? %>
    <div style="color: red; margin-bottom: 15px;">
      <h4>保存できませんでした (<%= @stock.errors.count %>件のエラー):</h4>
      <ul>
        <% @stock.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @stock, local: true do |f| %>
    <div style="margin-bottom: 15px;">
      <%= f.label :ticker_symbol, "銘柄コード（例: 7203 や AAPL）" %><br>
      <%= f.text_field :ticker_symbol, required: true, style: "width: 100%; padding: 8px;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :name, "銘柄名" %><br>
      <%= f.text_field :name, required: true, style: "width: 100%; padding: 8px;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :acquisition_price, "取得単価" %><br>
      <%= f.number_field :acquisition_price, step: "any", style: "width: 100%; padding: 8px;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :shares, "保有株数" %><br>
      <%= f.number_field :shares, step: "any", style: "width: 100%; padding: 8px;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :purchase_motivation, "購入動機（原点）" %><br>
      <%= f.text_area :purchase_motivation, rows: 3, style: "width: 100%; padding: 8px;", required: true %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :exit_scenario, "売却基準（シナリオ）" %><br>
      <%= f.text_area :exit_scenario, rows: 3, style: "width: 100%; padding: 8px;", placeholder: "例: 業績悪化時、-10%下落時など", required: true %>
    </div>

    <div>
      <%= f.submit "登録する", style: "padding: 10px 20px; background-color: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer;" %>
      <%= link_to "キャンセル", mypage_path, style: "margin-left: 10px;" %>
    </div>
  <% end %>
</div>
