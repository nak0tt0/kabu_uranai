<div style="padding: 20px; max-width: 1000px; margin: 0 auto;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h2>📈 保有銘柄一覧</h2>
    <div>
      <%= link_to "マイページへ戻る", user_path(current_user), style: "margin-right: 10px;" %>
      <%= link_to "新規銘柄登録", new_stock_path, style: "padding: 6px 12px; background-color: #28a745; color: white; border-radius: 4px; text-decoration: none;" %>
    </div>
  </div>

  <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
    <thead>
      <tr style="background-color: #f8f9fa; border-bottom: 2px solid #dee2e6;">
        <th style="padding: 10px; text-align: left;">銘柄コード</th>
        <th style="padding: 10px; text-align: left;">銘柄名</th>
        <th style="padding: 10px; text-align: right;">現在価格</th>
        <th style="padding: 10px; text-align: right;">取得単価</th>
        <th style="padding: 10px; text-align: right;">保有株数</th>
      </tr>
    </thead>
    <tbody>
      <% if @stocks.present? %>
        <% @stocks.each do |stock| %>
          <% service = StockPriceService.new(stock.ticker_symbol) %>
          <% price_data = service.fetch_data %>
          <tr style="border-bottom: 1px solid #dee2e6;">
            <td style="padding: 10px;"><%= stock.ticker_symbol %></td>
            <td style="padding: 10px;"><%= stock.name %></td>
            <td style="padding: 10px; text-align: right;">
              <% if price_data && price_data[:current_price] %>
                <%= price_data[:unit] == "$" ? "$" : "" %><%= number_with_precision(price_data[:current_price], precision: 2, delimiter: ",") %><%= price_data[:unit] == "円" ? "円" : "" %>
              <% else %>
                <span style="color: #888;">取得失敗</span>
              <% end %>
            </td>
            <td style="padding: 10px; text-align: right;"><%= number_with_precision(stock.acquisition_price, precision: 2, delimiter: ",") %></td>
            <td style="padding: 10px; text-align: right;"><%= stock.shares %></td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="5" style="padding: 20px; text-align: center;">登録されている銘柄はありません。</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
