<div style="padding: 20px;">
  <h2>保有銘柄一覧</h2>

  <% if flash[:notice].present? %>
    <p style="color: green;"><%= flash[:notice] %></p>
  <% end %>

  <div style="margin-bottom: 20px;">
    <%= link_to "＋ 新規銘柄登録", new_stock_path, style: "padding: 8px 12px; background-color: #28a745; color: white; text-decoration: none; border-radius: 4px;" %>
    <%= link_to "マイページへ戻る", mypage_path, style: "margin-left: 10px;" %>
  </div>

  <table border="1" cellpadding="10" cellspacing="0" style="width: 100%; border-collapse: collapse;">
    <thead>
      <tr style="background-color: #f2f2f2;">
        <th>銘柄コード</th>
        <th>銘柄名</th>
        <th>現在価格</th>
        <th>取得単価</th>
        <th>保有株数</th>
      </tr>
    </thead>
    <tbody>
      <% if @stocks.any? %>
        <% @stocks.each do |stock| %>
          <% price_data = StockPriceService.new(stock.ticker_symbol).fetch_data %>
          <tr>
            <td><%= stock.ticker_symbol %></td>
            <td><%= stock.name %></td>
            <td>
              <% if price_data && price_data[:current_price] %>
                <%= number_to_currency(price_data[:current_price], unit: "円", precision: 2) %>
              <% else %>
                <span style="color: #888;">取得失敗</span>
              <% end %>
            </td>
            <td><%= stock.acquisition_price %></td>
            <td><%= stock.shares %></td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="5" style="text-align: center;">登録されている銘柄はありません。</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
