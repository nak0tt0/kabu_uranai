<div style="max-width: 500px; margin: 40px auto; padding: 20px; border: 1px solid #ccc; border-radius: 8px;">
  <h2>新規会員登録</h2>

  <% if @user.errors.any? %>
    <div style="color: red; margin-bottom: 15px;">
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with(model: @user, url: signup_path, local: true) do |f| %>
    <div style="margin-bottom: 15px;">
      <%= f.label :name, "ユーザー名" %><br>
      <%= f.text_field :name, required: true, style: "width: 100%; padding: 8px;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :email, "メールアドレス" %><br>
      <%= f.email_field :email, required: true, style: "width: 100%; padding: 8px;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :password, "パスワード（6文字以上）" %><br>
      <%= f.password_field :password, required: true, style: "width: 100%; padding: 8px;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :password_confirmation, "パスワード（確認用）" %><br>
      <%= f.password_field :password_confirmation, required: true, style: "width: 100%; padding: 8px;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :investment_policy, "My投資憲章（マイルール）" %><br>
      <%= f.text_area :investment_policy, placeholder: "例：感情で売買しない。損切りラインは-10%など", rows: 4, style: "width: 100%; padding: 8px;" %>
    </div>

    <div>
      <%= f.submit "登録する", style: "width: 100%; padding: 10px; background-color: #28a745; color: white; border: none; border-radius: 4px; cursor: pointer;" %>
    </div>
  <% end %>
</div>
