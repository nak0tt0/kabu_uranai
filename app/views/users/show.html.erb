<div style="padding: 20px;">

  <h2>マイページ</h2>

  <% if @user %>
    <p>ようこそ、<strong><%= @user.name %></strong> さん！</p>
    <p>メールアドレス: <%= @user.email %></p>
    <p>My投資憲章: <%= @user.investment_policy %></p>

    <div style="margin-top: 20px;">
      <%= link_to "＋ 新規銘柄登録", new_stock_path, style: "padding: 10px 15px; background-color: #28a745; color: white; text-decoration: none; border-radius: 4px;" %>
    </div>

    <% else %>
    <p>ログインしていません。</p>
  <% end %>

</div>
