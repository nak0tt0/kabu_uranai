<div style="max-width: 500px; margin: 30px auto; padding: 20px; border: 1px solid #ccc; border-radius: 8px;">
  <h2>ユーザー情報編集</h2>

  <% if @user.errors.any? %>
    <div style="color: red; margin-bottom: 15px;">
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: user_path, method: :patch, local: true do |f| %>
    <div style="margin-bottom: 15px;">
      <%= f.label :name, "ユーザー名" %><br>
      <%= f.text_field :name, required: true, style: "width: 100%; padding: 8px;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :email, "メールアドレス" %><br>
      <%= f.email_field :email, required: true, style: "width: 100%; padding: 8px;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :investment_policy, "My投資憲章（マイルール）" %><br>
      <%= f.text_area :investment_policy, rows: 4, style: "width: 100%; padding: 8px;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :password, "新しいパスワード（変更する場合のみ）" %><br>
      <%= f.password_field :password, style: "width: 100%; padding: 8px;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :password_confirmation, "パスワード確認用" %><br>
      <%= f.password_field :password_confirmation, style: "width: 100%; padding: 8px;" %>
    </div>

    <div>
      <%= f.submit "更新する", style: "padding: 10px 20px; background-color: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer;" %>
      <%= link_to "マイページに戻る", mypage_path, style: "margin-left: 10px; color: #6c757d; text-decoration: none;" %>
    </div>
  <% end %>
</div>
